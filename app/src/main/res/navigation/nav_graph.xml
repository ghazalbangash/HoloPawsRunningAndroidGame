<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/contentMain">

    <fragment
        android:id="@+id/contentMain"
        android:label="Main Content"
        tools:layout="@layout/content_main">

        <action
            android:id="@+id/action_FirstFragment_to_SecondFragment"
            app:destination="@id/FirstFragment" />
    </fragment>
    <fragment
        android:id="@+id/FirstFragment"
        android:name="com.example.myFitHololenzApp.FirstFragment"
        android:label="First Frag"
        tools:layout="@layout/fragment_first">

        <action
            android:id="@+id/action_SecondFragment_to_FirstFragment"
            app:destination="@id/contentMain" />
    </fragment>
</navigation>